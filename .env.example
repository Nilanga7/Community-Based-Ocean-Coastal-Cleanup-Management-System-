# Copy this file to .env (repo root) and fill in real values for your machine.
# .env is gitignored — never commit your real one. docker-compose.yml reads these
# automatically; backend/src/main/resources/application.properties reads the DB_*
# ones too (via ${VAR:default} placeholders), as long as they're exported into the
# shell/IDE run config you start the backend from — Spring Boot does not load .env
# files on its own. If you never create a .env, everything falls back to the
# defaults already baked into docker-compose.yml / application.properties, so a
# fresh clone works with zero setup.

# --- Database (MySQL, brought up by `docker-compose up`) ---
DB_NAME=cleanup_system
DB_PORT=3308
DB_USERNAME=root
DB_PASSWORD=MySqL11

# --- JWT (stateless auth) ---
# JWT_SECRET has no default and the backend fails to start without it — never commit a real
# one. Generate a dev value with:
#   openssl rand -base64 32
JWT_SECRET=b7c16b53-da6b-473b-a8e0-20799e16fea2
# Access token lifetime in milliseconds. Falls back to 86400000 (24h) if unset.
JWT_EXPIRATION_MS=

# --- Bootstrap admin (AdminBootstrapRunner) ---
# Only used the very first time the backend starts with zero ADMIN accounts in the database —
# once an admin exists, these are ignored, so it's fine to leave them unset after that. Change
# INITIAL_ADMIN_PASSWORD to a strong password before any production-like run (never leave it as
# a dev placeholder), and rotate it after first login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Verification document storage (local disk) ---
# Directory diver/org registration documents get uploaded into (see LocalDiskFileStorageService).
# Falls back to ./uploads/verification-documents (relative to wherever the backend is started
# from) if unset — that path is gitignored (backend/.gitignore) so uploads never get committed.
VERIFICATION_DOCS_DIR=

# --- CORS (see SecurityConfig) ---
# Origin allowed to call this API from a browser. Falls back to http://localhost:5173 (Vite's
# dev server default) if unset — override for any deployed frontend origin.
CORS_ALLOWED_ORIGIN=

# --- Google Maps API key ---
# Used for map display/report location, and for geocoding a user's home address to
# lat/long at registration (needed for the alert-radius calculation). Provisioning
# owner still TBD — see "Google Maps API key ownership" under Open technical
# decisions in CLAUDE.md. Get a key at https://console.cloud.google.com/google/maps-apis
# once that's settled.
GOOGLE_MAPS_API_KEY=

# --- Notification service ---
# Provider not chosen yet — see "Notification service" under Open technical
# decisions in CLAUDE.md (push, email, or both). Placeholder key name below; rename
# once a provider is picked and update this file + the Alert & Notification module.
NOTIFICATION_SERVICE_API_KEY=
